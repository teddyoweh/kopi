 "components": {
  "schemas": {
   "AuthRequest": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code"
     }
    },
    "type": "object",
    "required": [
     "code"
    ],
    "title": "AuthRequest"
   },
   "AuthResponse": {
    "properties": {
     "token": {
      "type": "string",
      "title": "Token"
     },
     "expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Expires At"
     }
    },
    "type": "object",
    "required": [
     "token",
     "expires_at"
    ],
    "title": "AuthResponse"
   },
   "AwardExample": {
    "properties": {
     "tender_no": {
      "type": "string",
      "title": "Tender No"
     },
     "description": {
      "type": "string",
      "title": "Description"
     },
     "agency": {
      "type": "string",
      "title": "Agency"
     },
     "year": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Year"
     },
     "amount": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Amount"
     },
     "suppliers": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Suppliers"
     }
    },
    "type": "object",
    "required": [
     "tender_no",
     "description",
     "agency",
     "year",
     "amount",
     "suppliers"
    ],
    "title": "AwardExample"
   },
   "BcaWorkhead": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code",
      "examples": [
       "CW01"
      ]
     },
     "grade": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Grade",
      "examples": [
       "B2"
      ]
     }
    },
    "type": "object",
    "required": [
     "code"
    ],
    "title": "BcaWorkhead"
   },
   "ChatRequest": {
    "properties": {
     "message": {
      "type": "string",
      "title": "Message"
     },
     "session_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Session Id"
     },
     "profile": {
      "$ref": "#/components/schemas/Profile"
     },
     "doc_no": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Doc No",
      "description": "The tender the conversation is about, if any"
     }
    },
    "type": "object",
    "required": [
     "message",
     "profile"
    ],
    "title": "ChatRequest"
   },
   "EligibilityCheck": {
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "closing",
       "gra",
       "bca",
       "licence",
       "value",
       "company"
      ],
      "title": "Kind"
     },
     "requirement": {
      "type": "string",
      "title": "Requirement"
     },
     "status": {
      "$ref": "#/components/schemas/EligibilityStatus"
     },
     "reason": {
      "type": "string",
      "title": "Reason"
     },
     "source_url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Url"
     }
    },
    "type": "object",
    "required": [
     "kind",
     "requirement",
     "status",
     "reason"
    ],
    "title": "EligibilityCheck"
   },
   "EligibilityRequest": {
    "properties": {
     "doc_no": {
      "type": "string",
      "title": "Doc No"
     },
     "profile": {
      "$ref": "#/components/schemas/Profile"
     }
    },
    "type": "object",
    "required": [
     "doc_no",
     "profile"
    ],
    "title": "EligibilityRequest"
   },
   "EligibilityStatus": {
    "type": "string",
    "enum": [
     "met",
     "unmet",
     "unknown"
    ],
    "title": "EligibilityStatus"
   },
   "Fit": {
    "properties": {
     "score": {
      "type": "integer",
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Score"
     },
     "recommendation": {
      "$ref": "#/components/schemas/Recommendation"
     },
     "reasons": {
      "items": {
       "$ref": "#/components/schemas/Reason"
      },
      "type": "array",
      "title": "Reasons"
     }
    },
    "type": "object",
    "required": [
     "score",
     "recommendation",
     "reasons"
    ],
    "title": "Fit"
