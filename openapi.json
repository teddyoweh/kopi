   "GraHead": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code",
      "examples": [
       "EPU/CMP/10"
      ]
     },
     "label": {
      "type": "string",
      "title": "Label",
      "default": ""
     },
     "capacity_sgd": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Capacity Sgd",
      "description": "Tendering capacity named on the notice, e.g. 250000"
     },
     "grade": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
